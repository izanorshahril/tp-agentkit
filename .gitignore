# ============================================
# TP-AgentKit .gitignore
# ============================================

# Agent runtime state is created only when a task needs it.
.tp/state/**
.tp/session/**

# Local developer workspace state
.venv/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# Personal notes
my_*.txt
*.sh
/__*.py
/.tmp/

# Build artifacts
*.pyc
__pycache__/
*.pdb
*.dll
*.lib
*.exp
*.sdf
*.suo
*.user
ipch/

# OS files
.DS_Store
Thumbs.db
# End of ignore rules.